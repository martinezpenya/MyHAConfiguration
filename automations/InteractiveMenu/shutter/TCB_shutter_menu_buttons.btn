         - "{% if is_state('light.shutter_room_button_led', 'on') %} \U0001F6AA Room \U0001f315:/TCB_shutter_toggle_led_room{% else %} \U0001F6AA Room \U0001f311:/TCB_shutter_toggle_led_room{% endif %}"
         - " {%- for i in range(1,(state_attr('cover.shutter_room','current_position')/4)|int) -%}_{%- endfor -%}{%- for i in range((state_attr('cover.shutter_room','current_position')/4)|int,(100/4)|int) -%}*{%- endfor -%} "
         - "\U000023ee :/TCB_shutter_room_close, 
