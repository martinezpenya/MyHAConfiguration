         - "{% if is_state('light.shutter_office_button_led', 'on') %} \U0001F3E2 Office \U0001f315:/TCB_shutter_toggle_led_office{% else %} \U0001F3E2 Office \U0001f311:/TCB_shutter_toggle_led_office{% endif %}"
