         - "\U000023ee :/TCB_shutter_close, 
            \U000023ea :/TCB_shutter_bitopen,
            \U000023f9 :/TCB_shutter_stop,
            \U000023e9 :/TCB_shutter_half,
            \U000023ed :/TCB_shutter_open"        
