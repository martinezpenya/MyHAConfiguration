         - " {%- for i in range(1,(state_attr('cover.shutter_sleep','current_position')/4)|int) -%}_{%- endfor -%}{%- for i in range((state_attr('cover.shutter_sleep','current_position')/4)|int,(100/4)|int) -%}*{%- endfor -%} "
         - "\U000023ee :/TCB_shutter_sleep_close, 
